# ─────────────────────────────────────────────────────────────────────────────
# Konfigurasi Prometheus remote write
# Dipakai saat flag  -Prometheus  (CLI k6perf) ATAU toggle "Prometheus (Grafana)"
# di web dashboard (Run Test). Satu sumber untuk keduanya.
#
# Edit host di sini bila Prometheus TIDAK di localhost.
# Catatan: env yang sudah di-set manual sebelum run tetap diprioritaskan
#          (file ini hanya nilai default).
# ─────────────────────────────────────────────────────────────────────────────
K6_PROMETHEUS_RW_SERVER_URL=http://localhost:9090/api/v1/write
K6_PROMETHEUS_RW_TREND_STATS=p(90),p(95),p(99),min,max,avg
