# ── Dependencies ──────────────────────────────────────────────────────────────
# node_modules tidak di-commit. Jalankan: npm install && cd dashboard && npm install
# (Khusus Gitea internal: lihat branch dev-gitea yang sudah include node_modules)
node_modules/
dashboard/node_modules/
# dashboard/dist sengaja DI-COMMIT (artefak build) supaya server offline bisa
# langsung `k6perf dashboard` tanpa npm install/build. Build ulang sebelum
# commit bila mengubah dashboard/src: cd dashboard && npm run build
dashboard/public/docs/

# ── k6 binary (portable) ──────────────────────────────────────────────────────
# Binary disimpan di bin/ tapi tidak ikut di-commit (ukuran besar).
bin/k6.exe
bin/k6
k6.exe
k6

# ── Script & scenario spesifik project ────────────────────────────────────────
# Hanya template & contoh yang masuk repo. Script aktif per-project disimpan lokal.
workspace/scripts/*/
!workspace/scripts/_template/
!workspace/scripts/_exampleChannel/

workspace/scenarios/scenario_*.js
!workspace/scenarios/scenario_template.js
!workspace/scenarios/scenario_example.js

# ── Hasil test ────────────────────────────────────────────────────────────────
results/
*.html
report*.html
!dashboard/**/*.html

# ── Screenshot / scratch lokal ────────────────────────────────────────────────
screenshots/

# ── OS & editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
